node_modules/
dist/
.vite/
# Playwright e2e output (apps/*/e2e)
test-results/
playwright-report/
*.log
*.tgz
.DS_Store
.env
.env.*

# Internal Claude Design-sync tooling — local-only, never in the public repo.
.ds-sync/
ds-bundle/
.design-sync/
packages/catalogue/

# Derived: the prebuilt browser runtime vendored into the CLI by build:cli
# (a vite build of apps/runtime that `zframes serve` ships)
packages/cli/runtime/

# Local dev dogfood data — `pnpm dev` reads/writes this (it's the in-browser
# editor's Save target), but it's a local working file, not a published
# artifact. The shipped CLI never uses it. Create your own to run dev (e.g.
# `zframes init apps/runtime/src/dashboard.json`).
apps/runtime/src/dashboard.json

# Local-only docs — kept on disk, never committed to the public repo.
# Everything under docs/ is local working material (the six-slot taxonomy:
# central-plan/, decisions/, specs/, reference/, artifacts/, archive/) EXCEPT
# docs/assets/ (README images), which stays tracked.
docs/*
!docs/assets/

# Local-only scratch & promo tooling (root-level only) — Python generators and
# their large generated JSON outputs (theme variants, gap-test fixtures). Local
# working files, not project source, never committed to the public repo. The
# leading slash anchors to the repo root so the CLI's own packages/cli/scripts/
# stays tracked.
/scripts/
/promo/

# Python bytecode — should never be committed anywhere in this JS/TS repo.
__pycache__/
*.pyc
.claude/

# scheduled-monitor generated reports (.github/scripts)
provider-smoke-report.json
cli-smoke-report.json
audit-report.json
frame-render-report.json
fx-coverage-report.json
dashboard-validity-report.json

# frame size-envelope audit artifacts (.github/scripts/frame-size-*.ts). The raw
# 12x8 measurement matrix, the derived bounds and the contact sheets are evidence
# for one run — regenerated on demand; the bounds they justify live in schemas.ts.
frame-size-probe.json
frame-size-bounds.json
frame-size-bounds.merged.json
frame-bounds-review.json
frame-meta.json
frame-size-sheets/

# copy-widget-icons.mjs resolves its destination from the CWD (each app vendors
# the PNGs on predev/prebuild, run with cwd=apps/<app>). Running it from the repo
# root instead drops ~1.5 MB of duplicate icons here; the repo has no legitimate
# root public/, so make that accident uncommittable.
/public/

# Pre-PR review gate artifacts (diff snapshot, raw reviews, verdict). Local evidence
# for one revision — regenerated per round, never committed.
.magi-review/
.magi-review.lock
.magi-review-history.jsonl

# plans/ is local-only: audit-round plans that summarize internal findings and
# landed commit hashes. Kept on disk, stripped from git history 2026-08-24;
# never push it to origin.
plans/

# stray root scratch image, local-only
/bk-top.jpg
