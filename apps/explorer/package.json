{
  "name": "@zframes/explorer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../packages/frames/scripts/copy-widget-icons.mjs",
    "dev": "next dev -p 37264",
    "prebuild": "node ../../packages/frames/scripts/copy-widget-icons.mjs",
    "build": "next build",
    "start": "next start -p 37264",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U postgres",
    "thumbs:capture": "tsx scripts/capture-thumbs.ts",
    "migrate": "tsx scripts/migrate.ts",
    "check:schema": "tsx scripts/check-schema-drift.ts",
    "seed:curated": "tsx scripts/seed-curated.ts",
    "validate:dashboards": "tsx scripts/validate-dashboards.ts",
    "seo:audit": "tsx scripts/seo-audit.ts",
    "sweep:likes": "tsx scripts/sweep-like-grants.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zframes/charts": "workspace:*",
    "@zframes/core": "workspace:*",
    "@zframes/data-primitives": "workspace:*",
    "@zframes/editor": "workspace:*",
    "@zframes/frames": "workspace:*",
    "@zframes/provider-demo": "workspace:*",
    "@zframes/provider-wallet": "workspace:*",
    "@zframes/providers-keyless": "workspace:*",
    "@zframes/serve": "workspace:*",
    "@zframes/spec": "workspace:*",
    "@zframes/unicorn": "workspace:*",
    "agentation": "^3.1.2",
    "better-auth": "^1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "gridstack": "^13.1.0",
    "lucide-react": "^1.59.0",
    "motion": "^12.42.2",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
