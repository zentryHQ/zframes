{
  "version": "1.0.0",
  "title": "Quant Terminal",
  "author": "zframes",
  "grid": {
    "columns": 12,
    "rowHeight": 96,
    "gap": 12
  },
  "background": {
    "type": "unicorn",
    "projectId": "PrFtFGDE5duemLmr2YKQ",
    "opacity": 0.12
  },
  "theme": {
    "accentHue": 145,
    "accentSat": 85,
    "baseHue": 150,
    "baseSat": 16,
    "upColor": "#3fd08f",
    "downColor": "#ff6b6b"
  },
  "typography": {
    "fontFamily": "mono",
    "numericStyle": "tabular",
    "scale": 1
  },
  "appearance": {
    "radius": 4,
    "borderStrength": 0.34,
    "surfaceOpacity": 1,
    "density": 0.85,
    "elevation": 0.4
  },
  "frames": [
    {
      "id": "brand-hero",
      "frame": "image",
      "position": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "config": {
        "url": "/hero.png",
        "alt": "Quant Terminal",
        "fit": "cover"
      }
    },
    {
      "id": "tape-liveline",
      "frame": "price-liveline",
      "position": {
        "x": 3,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "config": {
        "symbols": ["xyz:NVDA", "xyz:TSLA", "xyz:AAPL", "xyz:AMD", "xyz:MSFT"],
        "normalize": true
      }
    },
    {
      "id": "brand-note",
      "frame": "note",
      "position": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 3
      },
      "config": {
        "text": "QUANT TERMINAL\n\nPrice is truth. The tape doesn't lie.\n\nBig-tech flow, short interest, and the curve — signal over story, every session.",
        "align": "left"
      }
    },
    {
      "id": "tape-heading",
      "frame": "heading",
      "position": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 1
