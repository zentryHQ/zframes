{
  "name": "zframes-monorepo",
  "description": "AI-personalizable market dashboard framework — an agent reads the frame catalogue, emits a dashboard.json spec, and the runtime validates and renders it as a live dashboard.",
  "license": "MIT",
  "author": "Zentry",
  "repository": {
    "type": "git",
    "url": "https://github.com/zentryhq/zframes.git"
  },
  "private": true,
  "packageManager": "pnpm@9.6.0",
  "scripts": {
    "dev": "pnpm --filter @zframes/runtime dev",
    "build": "pnpm --filter @zframes/runtime build",
    "typecheck": "pnpm -r typecheck",
    "zframes": "node packages/cli/dist/index.js",
    "build:cli": "pnpm --filter zframes build",
    "prepare": "node .githooks/install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:providers": "tsx .github/scripts/provider-smoke.ts",
    "test:frames:render": "tsx .github/scripts/frame-render-smoke.ts",
    "frames:meta": "tsx .github/scripts/dump-frame-meta.mts",
    "frames:size:probe": "tsx .github/scripts/frame-size-probe.ts",
    "frames:size:derive": "tsx .github/scripts/derive-frame-bounds.ts",
    "frames:size:explain": "tsx .github/scripts/explain-frame-bounds.ts",
    "frames:size:apply": "tsx .github/scripts/apply-frame-bounds.ts",
    "frames:size:sheet": "tsx .github/scripts/frame-size-sheet.ts"
  },
  "pnpm": {
    "patchedDependencies": {
      "liveline@0.0.7": "patches/liveline@0.0.7.patch"
    },
    "overrides": {
      "nanoid@<3.3.17": ">=3.3.17",
      "postcss@>=8.0.0 <8.5.23": ">=8.5.23",
      "sharp@<0.35.0": ">=0.35.0",
      "undici@>=7.0.0 <7.29.0": "^7.29.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@zframes/provider-sec": "workspace:^",
    "@zframes/provider-wallet": "workspace:^",
    "@zframes/providers-keyless": "workspace:^",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.53.0",
    "prettier": "^3.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
